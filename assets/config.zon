.{
    // gap between windows and screen's top/bottom edge
    .inner_gap = 15,
    // gap between adjacent windows
    .outer_gap = 15,
    // default proportion of the screen's available width that a window occupies when spawned
    .window_width_proportion = 0.5,
    // duration of animations, in milliseconds
    .animation_duration = 150,

    .spawn_at_startup = .{
        // .{"awww-daemon"},
        // .{ "wl-clip-persist", "--clipboard", "both" },
    },

    // modifiers: shift, ctrl, mod1 (alt), mod4 (super)
    .keybinds = .{
        .{
            .key = "t",
            .modifier = .{ .mod4 = true },
            .action = .{ .spawn = .{"alacritty"} },
        },

        .{
            .key = "q",
            .modifier = .{ .mod4 = true },
            .action = .close_window,
        },
        .{
            .key = "h",
            .modifier = .{ .mod4 = true },
            .action = .focus_window_left,
        },
        .{
            .key = "l",
            .modifier = .{ .mod4 = true },
            .action = .focus_window_right,
        },
        .{
            .key = "h",
            .modifier = .{ .mod4 = true, .shift = true },
            .action = .move_window_left,
        },
        .{
            .key = "l",
            .modifier = .{ .mod4 = true, .shift = true },
            .action = .move_window_right,
        },

        // Adjust the width of focused window, in percentage
        .{
            .key = "-",
            .modifier = .{ .mod4 = true },
            // decrease by 10% of the screen's available width
            .action = .{ .adjust_window_width = -10 },
        },
        .{
            .key = "=",
            .modifier = .{ .mod4 = true },
            // increase by 10% of the screen's available width
            .action = .{ .adjust_window_width = 10 },
        },
        .{
            .key = "f",
            .modifier = .{ .mod4 = true, .shift = true },
            .action = .toggle_fullscreen,
        },

        .{
            .key = "1",
            .modifier = .{ .mod4 = true },
            .action = .{ .focus_workspace = 1 },
        },
        .{
            .key = "2",
            .modifier = .{ .mod4 = true },
            .action = .{ .focus_workspace = 2 },
        },
        .{
            .key = "3",
            .modifier = .{ .mod4 = true },
            .action = .{ .focus_workspace = 3 },
        },
        .{
            .key = "4",
            .modifier = .{ .mod4 = true },
            .action = .{ .focus_workspace = 4 },
        },
        .{
            .key = "5",
            .modifier = .{ .mod4 = true },
            .action = .{ .focus_workspace = 5 },
        },
        .{
            .key = "6",
            .modifier = .{ .mod4 = true },
            .action = .{ .focus_workspace = 6 },
        },
        .{
            .key = "7",
            .modifier = .{ .mod4 = true },
            .action = .{ .focus_workspace = 7 },
        },
        .{
            .key = "8",
            .modifier = .{ .mod4 = true },
            .action = .{ .focus_workspace = 8 },
        },
        .{
            .key = "9",
            .modifier = .{ .mod4 = true },
            .action = .{ .focus_workspace = 9 },
        },
        .{
            .key = "0",
            .modifier = .{ .mod4 = true },
            .action = .{ .focus_workspace = 10 },
        },

        .{
            .key = "r",
            .modifier = .{ .mod4 = true, .shift = true },
            .action = .reload_config,
        },
    },
}
